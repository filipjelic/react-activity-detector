{
    "env": {
        "browser": true,
        "es2021": true
    },
    "extends": [
        "eslint:recommended",
        "plugin:react/recommended"
    ],
    "parserOptions": {
        "ecmaFeatures": {
            "jsx": true
        },
        "ecmaVersion": "latest",
        "sourceType": "module"
    },
    "plugins": [
        "react"
    ],
    "settings": {
        "react": {
            "version": "detect"
        }
    },
    "ignorePatterns": [
        "lib"
    ],
    "overrides": [
        {
            "files": ["*.config.js", "scripts/**/*.js"],
            "env": {
                "node": true
            }
        },
        {
            "files": ["**/*.test.js"],
            "env": {
                "jest": true
            }
        }
    ],
    "rules": {
    }
}
